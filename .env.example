# ============================================================
# TsuduNavi 環境変数設定例
# このファイルをコピーして .env を作成し、各値を入力してください
#   cp .env.example .env
# ============================================================

# ── LINE Messaging API ────────────────────────────────────────────────────
# LINE DevelopersコンソールのMessaging API設定ページで取得
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# ── Anthropic Claude API ──────────────────────────────────────────────────
# https://console.anthropic.com で取得
ANTHROPIC_API_KEY=your_anthropic_api_key
# 使用するモデルID（省略時は claude-sonnet-4-6 を使用）
CLAUDE_MODEL=claude-sonnet-4-6

# ── Supabase ──────────────────────────────────────────────────────────────
# Supabaseプロジェクトの Settings > API で取得
# SUPABASE_KEY は service_role キーを推奨（バックエンド専用のため）
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ── エージェント設定 ──────────────────────────────────────────────────────
# 退塾リスク検知通知の送り先（塾長の LINE ユーザーID）
DIRECTOR_LINE_USER_ID=your_director_line_user_id

# ── Google Calendar ───────────────────────────────────────────────────────
# GCPコンソールでサービスアカウントを作成し、JSONキーをダウンロードする
# そのJSONの内容をそのまま1行の文字列として設定する
# サービスアカウントのメールアドレスをカレンダーの「編集者」として共有設定すること
GOOGLE_CALENDAR_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
# カレンダーID（Google Calendarの設定 > カレンダーの統合 で確認）
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
